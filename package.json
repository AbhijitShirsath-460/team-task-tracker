{
  "name": "team-task-tracker",
  "version": "1.0.0",
  "description": "REST API for team-based task tracking with JWT auth, RBAC, Redis caching, and Docker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
